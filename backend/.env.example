# Supabase dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
# "service_role" secret key. Server-side only, never commit or ship to a browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional
SUPABASE_BUCKET=product-images
# Comma-separated list of allowed origins (leave empty to allow all during development)
CORS_ORIGIN=
PORT=5000

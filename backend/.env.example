# Supabase dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
# "service_role" secret key. Server-side only, never commit or ship to a browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional
SUPABASE_BUCKET=product-images
# Comma-separated list of allowed origins (leave empty to allow all during development)
CORS_ORIGIN=
PORT=5000
# Where the storefront runs; used for password-reset links
FRONTEND_URL=http://localhost:5173

# Only needed for the one-time setup scripts (npm run setup-db / configure-auth)
# Supabase dashboard -> Connect -> Session pooler connection string (with your DB password)
DATABASE_URL=
# supabase.com/dashboard/account/tokens -> Generate new token
SUPABASE_ACCESS_TOKEN=

# Supabase → Project Settings → Data API / API Keys
SUPABASE_URL=https://your-project-ref.supabase.co
# Server-only secret. Never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_BUCKET=product-images

# Where the site runs; used for links in confirmation and reset emails.
# On Vercel you can leave this out: the production domain is detected automatically.
SITE_URL=http://localhost:3000

# Only needed for the helper scripts (npm run setup-db / configure-auth)
DATABASE_URL=
SUPABASE_ACCESS_TOKEN=
